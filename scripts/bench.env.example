# Copy to scripts/bench.env (gitignored) and adjust. Sourced by scripts/_env.sh.
#
# Optionally load your shell profile so non-interactive runs see your keys:
# source ~/.profile 2>/dev/null
#
# Ordered, comma-separated env-var NAMES to try for the Anthropic key.
# The first non-empty one is exported as ANTHROPIC_API_KEY.
PACT_BENCH_API_KEY_ENV=ANTHROPIC_API_KEY
